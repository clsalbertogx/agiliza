# Database
DATABASE_URL=postgresql://dev:dev@localhost:5432/agiliza

# Redis
REDIS_URL=redis://localhost:6379

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key

# Payment Provider (default: Asaas)
PAYMENT_PROVIDER=asaas
ASAAS_API_KEY=your-asaas-api-key
ASAAS_ENVIRONMENT=sandbox

# App
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
FRONTEND_URL=http://localhost:3000

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3333

# JWT
JWT_SECRET=agiliza-dev-secret-change-in-production

# API Keys
MASTER_API_KEY=agiliza-dev-api-key-change-in-production

# Webhook Secrets
ASAAS_WEBHOOK_SECRET=asaas-webhook-secret-change-in-production
MERCADOPAGO_WEBHOOK_SECRET=mercadopago-webhook-secret-change-in-production
EVOLUTION_API_KEY=evolution-api-key-change-in-production

# Payment Provider
ASAAS_API_KEY=your-asaas-api-key
ASAAS_ENVIRONMENT=sandbox
