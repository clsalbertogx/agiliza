# Database
DATABASE_URL=postgresql://dev:dev@localhost:5432/agiliza

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=changeme

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key
# Optional: comma-separated source-IP allowlist for the /api/webhooks/evolution endpoint
EVOLUTION_ALLOWED_IPS=

# App
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
FRONTEND_URL=http://localhost:3000

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_DEMO_MODE=false

# JWT — REQUIRED (no default: a deployment without it fails fast)
JWT_SECRET=agiliza-dev-secret-change-in-production

# Encryption
ENCRYPTION_KEY=agiliza-encryption-key-change-in-production

# API Keys
# MASTER_API_KEY — REQUIRED (no default: a deployment without it fails fast)
MASTER_API_KEY=agiliza-dev-api-key-change-in-production

# Payment Provider (default: Asaas)
PAYMENT_PROVIDER=asaas
# ASAAS_API_KEY — REQUIRED (no default: a deployment without it fails fast)
ASAAS_API_KEY=your-asaas-api-key
ASAAS_ENVIRONMENT=sandbox

# Mercado Pago (optional)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PagBank (optional)
PAGBANK_ACCESS_TOKEN=
PAGBANK_PUBLIC_KEY=
PAGBANK_WEBHOOK_SECRET=

# Polar (optional)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_MAX=100

# Webhook Secrets
ASAAS_WEBHOOK_SECRET=asaas-webhook-secret-change-in-production

# Outbound Webhook (optional — forward events to external system)
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_API_KEY=

# Slack Alerting (optional — leave empty to disable critical-event notifications)
SLACK_WEBHOOK_URL=
