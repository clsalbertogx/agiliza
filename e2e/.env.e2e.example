# E2E Test Environment Variables
# Copy this file to .env.e2e and adjust as needed.

# Backend API URL — used by the API-level specs (via Playwright's request
# fixture): client-flow, invoice-flow, onboarding-flow, error-states,
# backend-health.
API_URL=http://localhost:3333

# Frontend URL — OPTIONAL. Required only by the browser-level spec
# (dashboard-navigation). CI starts only the backend, so this stays unset there
# and the browser spec is skipped with an explicit reason. Set it locally when
# the frontend is running (also see scripts/e2e-setup.sh --with-frontend).
# E2E_FRONTEND_URL=http://localhost:3000
